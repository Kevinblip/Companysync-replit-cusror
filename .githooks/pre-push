#   5. Slack webhook delivery-check tests — triggers on
#                                       scripts/test-slack-webhook-check.sh,
#                                       scripts/post-deploy-privacy-check.sh,
#                                       or scripts/post-deploy-body-limit-check.sh
#   6. Resend verify-action jq tests  — triggers on
#                                       .github/actions/verify-resend-delivery/**
#                                       or scripts/test-resend-verify-action.sh
#   7. Estimate-token HMAC unit tests — triggers on lib/estimateToken.cjs,
#                                       functions/_estimateToken.ts,
#                                       or scripts/test-estimate-token.cjs
#   8. Pre-push shell-guard self-test  — triggers on .githooks/pre-push
#                                       or scripts/test-pre-push-shell-guard.sh
#   9. Insurance estimate template tests — triggers on
#                                       src/utils/insuranceEstimateTemplates.js
#  10. Duplicate-payment guard tests   — triggers on
