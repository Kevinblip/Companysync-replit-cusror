# ── Bash-shell guard ──────────────────────────────────────────────────────────
# $BASH_VERSION is only set when the interpreter is bash.  If this script is
# somehow sourced or executed by a non-bash shell (sh, dash, zsh, …) we skip
# all checks rather than producing cryptic syntax errors.
if [ -z "${BASH_VERSION:-}" ]; then
  echo ""
  echo "[pre-push] WARNING: This hook requires bash but is running under a different shell."
  echo "[pre-push] Skipping all pre-push checks. Ensure Git uses bash to enable linting."
  echo ""
  exit 0
fi

set -euo pipefail

# ── Node.js availability guard ────────────────────────────────────────────────
# All checks in this hook require Node.js.  If it isn't on PATH we emit a
# clear warning and allow the push to proceed so that machines without Node
# (e.g. CI runners that use a different image, or fresh dev boxes) are never
# silently blocked by a "node: command not found" error.
if ! command -v node >/dev/null 2>&1; then
  echo ""
  echo "[pre-push] WARNING: Node.js not found on PATH — skipping all hook checks."
  echo "[pre-push] Install Node.js (https://nodejs.org) to enable pre-push linting."
  echo ""
  exit 0
fi

# Optional minimum version check (requires Node >= 18).
_NODE_MAJOR="$(node -e 'process.stdout.write(String(process.versions.node.split(".")[0]))')"
if [ "$_NODE_MAJOR" -lt 18 ] 2>/dev/null; then
  echo ""
  echo "[pre-push] WARNING: Node.js v${_NODE_MAJOR} detected — hook checks require Node >= 18."
  echo "[pre-push] Skipping checks. Upgrade Node.js to enable pre-push linting."
  echo ""
  exit 0
fi

REMOTE="$1"
URL="$2"

NULL_SHA="0000000000000000000000000000000000000000"

# Accumulate every changed file path across all pushed refs into one list.
# We process stdin (the ref pairs Git feeds us) in a single pass and store
# the combined diff in a temp file so each check can query it independently.
CHANGED_FILES_TMP="$(mktemp)"
trap 'rm -f "$CHANGED_FILES_TMP"' EXIT

# Nearest remote-tracking ancestor of $1, otherwise the empty tree.
# A brand-new branch has no remote SHA. Diffing that push against an empty
# tree marks every file in the repo as changed and runs checks for code the
# branch did not touch. Use the closest ancestor already on origin so the
# checks follow the commits being pushed.
nearest_pushed_base() {
  local sha="$1"
  local tip distance best_tip="" best_distance=""
  while read -r tip; do
    [ -n "$tip" ] || continue
    if git merge-base --is-ancestor "$tip" "$sha" 2>/dev/null; then
      distance="$(git rev-list --count "${tip}..${sha}" 2>/dev/null || echo 999999)"
      if [ -z "$best_distance" ] || [ "$distance" -lt "$best_distance" ]; then
        best_distance="$distance"
        best_tip="$tip"
      fi
    fi
  done < <(git for-each-ref --format='%(objectname)' refs/remotes/origin)
  if [ -n "$best_tip" ]; then
    printf '%s\n' "$best_tip"
  else
    git hash-object -t tree /dev/null
  fi
}

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$NULL_SHA" ]; then
    continue
  elif [ "$remote_sha" = "$NULL_SHA" ]; then
    BASE="$(nearest_pushed_base "$local_sha")"
  else
    BASE="$remote_sha"
  fi

  git diff --name-only "$BASE" "$local_sha" 2>/dev/null >> "$CHANGED_FILES_TMP" || true
done

HOOK_FAILED=0

# ── Helper ────────────────────────────────────────────────────────────────────
# changed_match [grep-flags] <pattern>
#   Returns 0 (true) if any changed file path matches the pattern.
#   All arguments are forwarded to grep so flags like -E work correctly.
changed_match() {
  grep -q "$@" "$CHANGED_FILES_TMP" 2>/dev/null
}

