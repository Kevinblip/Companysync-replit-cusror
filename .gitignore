#env
.env
.env.*
!.env.example

# Extracted Microsoft footprint sub-tiles. The project disk survives a Replit
# restart; the OS temp dir does not. Do not commit the tiles.
.cache/

# User-uploaded files — kept on disk / object storage, not in git
public/uploads/
data/sales-agent/
# UUID-named uploads written by the dev server (homeowner photos, etc.)
public/*.jpg
public/*.jpeg
public/*.png
public/*.webp

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env

# Marketing video intermediate files
scripts/mv-tmp/
scripts/video/clips/
scripts/video/final/
scripts/video/audio/
scripts/video/frames/

# Large app videos live in Replit Object Storage (videos/… and
# generated_marketing_videos/… under the public prefix), served via 302
# signed-URL redirect. Never commit them back into the package.
public/videos/
public/generated_marketing_videos/
attached_assets/generated_videos/
attached_assets/demo-video/
attached_assets/*.zip
tmp-roof-debug/
uploads-malec/
