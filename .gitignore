#env
.env
.env.*

# Capacitor local build output and signing material.
# The synced web bundle is rebuilt by scripts/build-mobile.sh. Do not commit
# a second and third copy of dist into the native projects.
dist-mobile/
android/app/src/main/assets/public/
ios/App/App/public/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/google-services.json
ios/App/Pods/
ios/App/build/
ios/App/App/GoogleService-Info.plist
*.jks
*.keystore
*.mobileprovision
*.p8

# User-uploaded files — kept on disk / object storage, not in git
public/uploads/
# UUID-named uploads written by the dev server (homeowner photos, etc.)
public/*.jpg
public/*.jpeg
public/*.png
public/*.webp

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env

# Marketing video intermediate files
scripts/mv-tmp/
scripts/video/clips/
scripts/video/final/
scripts/video/audio/
scripts/video/frames/

# Large app videos live in Replit Object Storage (videos/… and
# generated_marketing_videos/… under the public prefix), served via 302
# signed-URL redirect. Never commit them back into the package.
public/videos/
public/generated_marketing_videos/
attached_assets/generated_videos/
attached_assets/demo-video/
attached_assets/*.zip
tmp-roof-debug/
