modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "unzip", "xcbuild"]

[env]
PORT = "5000"

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/start-production.sh"]
build = ["bash", "-c", "printf '[Publish] Build Node: %s\\n' \"$(node --version)\" && npm run build && NODE_OPTIONS='--network-family-autoselection-attempt-timeout=' bash scripts/start-production.sh --version && node scripts/check-publish-footprint.cjs before-cleanup && printf '%s\\n' '[Publish] Starting exclusions in disposable publish builder; source workspace is unchanged.' && rm -rf .git .local .agents .canvas attached_assets public && for attempt in 1 2 3; do if rm -rf .cache; then break; elif [ \"$attempt\" -eq 3 ]; then printf '%s\\n' '[Publish] WARNING: temporary .cache is still busy after 3 cleanup attempts; keeping remaining cache files.'; else sleep 1; fi; done && node scripts/check-publish-footprint.cjs after-cleanup && printf '%s\\n' '[Publish] Build command completed successfully; ready for image layer creation.'"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "email-delivery-status"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "teammate-name-match"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lexi-team-chat"

[[workflows.workflow]]
