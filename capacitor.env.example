# Copy values into your shell when building the store app. None of these are secrets.
# The mobile build script reads mobile.config.json when these are unset.

# Bundle id / applicationId. Keep in sync with mobile.config.json.
CAPACITOR_APP_ID=com.getcompanysync.app
CAPACITOR_APP_NAME=CompanySync

# Production API the bundled app calls. No trailing slash.
VITE_API_BASE_URL=https://getcompanysync.com

# Leave empty to ship bundled assets (required for App Store guideline 4.2).
# Set only for a temporary remote-URL debug build.
CAPACITOR_SERVER_URL=

# Push registration stays off until APNs (iOS) and FCM (Android) are configured.
# The app never sends notifications. Turning this on only requests permission
# and stores the device token locally.
VITE_PUSH_ENABLED=false
