# Platform mail. companysync.io stays FIRST so an unverified From address is
# still rewritten to noreply@companysync.io. Listing getcompanysync.com stops
# that rewrite for Cole (cole.ai@getcompanysync.com). Do not drop companysync.io
# or put another domain first — that would change the noreply fallback.
POSTMARK_VERIFIED_DOMAINS=companysync.io,getcompanysync.com

# Cole, the AI sales agent. These are the defaults when unset.
# Gemini Live voice for Cole only. Fenrir, Charon, Orus, or Puck.
SALES_AGENT_VOICE=Fenrir
SALES_AGENT_EMAIL_FROM=Cole from CompanySync <cole.ai@getcompanysync.com>
SALES_AGENT_REPLY_TO=cole.ai@getcompanysync.com

# Shared secret for POST /api/sales-agent/inbound-email (Postmark inbound webhook).
# Send it as HTTP Basic password, Authorization: Bearer, or x-sales-agent-inbound-secret.
# The route does not send mail. STAGING_READ_ONLY_SIDE_EFFECTS=1 still suppresses
# every real sales-agent send.
SALES_AGENT_INBOUND_SECRET=

# Set to 1 on staging so email, SMS, and calls are logged instead of sent.
# STAGING_READ_ONLY_SIDE_EFFECTS=1
