# Copy to .env and fill in local values. Never commit .env.
# Vite (`npm run dev` / `npm run build`) loads .env automatically.
# `npm start` loads .env via scripts/start.cjs, then runs prod-server.cjs.
#
# WARNING: `.replit` currently contains [userenv.shared] secrets in the repo.
# Rotate those production values. Do NOT copy them into this file or into .env.

# --- Required for local boot / sessions ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/companysync
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000

# Public URL used in emails and some redirects (local default)
VITE_REPLIT_APP_URL=http://localhost:5000

# --- Google (OAuth login + Calendar). Aliases: Google_Client_Id / Google_Secret_Key ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PHONE_FROM=

# --- Stripe (Deno functions). Vite Stripe plugin uses Replit connectors, not these keys. ---
STRIPE_SECRET_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- GoHighLevel ---
GHL_API_KEY=

# --- Email (SMTP preferred; else Resend) ---
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_DOMAIN=

# --- Optional: AI key encryption, admin, mailer ---
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_FIX_KEY=
MAILER_WEBHOOK_SECRET=
RENTCAST_API_KEY=
POSTGRID_API_KEY=

# --- Base44 (kept in vite.config; not required if local SDK is used) ---
# Set to true only if you still import the legacy @base44/sdk in app code.
BASE44_LEGACY_SDK_IMPORTS=false
# Optional. If unset, the Vite plugin logs "Proxy not enabled" and local APIs still run.
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_FUNCTIONS_URL=
BASE44_SARAH_API_URL=
BASE44_LEXI_BRIDGE_API_URL=
SARAH_BRIDGE_SECRET=
LEXI_NATIVE_BRIDGE_SECRET=

# --- Replit OIDC (optional locally; email/password + Google still work without these) ---
REPL_ID=
ISSUER_URL=https://replit.com/oidc
